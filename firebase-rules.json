{
  "rules": {
    ".read": false,
    ".write": false,
    "coba": {
      "$ma": {
        ".read": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!data.exists() || (!newData.exists() && (data.child('tao').val() < now - 86400000 || data.child('xong').val() < now - 300000)))",
        ".validate": "newData.hasChildren(['tao', 'chu', 'kho', 'ghe'])",
        "tao": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "chu": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
        "kho": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
        "luat": { ".write": "!root.child('coba/' + $ma + '/batDau').exists()", ".validate": "newData.val() === 'tq'" },
        "gio": { ".write": "!root.child('coba/' + $ma + '/batDau').exists()", ".validate": "newData.isString() && newData.val().matches(/^(n30|n60|v5|v10)$/)" },
        "ghe": {
          "$P": {
            ".validate": "$P.matches(/^[012]$/) && newData.hasChild('id')",
            "id": {
              ".write": "!data.exists() && !root.child('coba/' + $ma + '/batDau').exists()",
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,16}$/)"
            },
            "ten": { ".write": true, ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "thay": { ".write": true, ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "batDau": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "may": {
          "$P": { ".write": true, ".validate": "$P.matches(/^[012]$/) && (newData.val() === 'ho' || newData.val() === 'rua')" }
        },
        "nuoc": {
          "$n": {
            ".write": "!data.exists() && root.child('coba/' + $ma + '/batDau').exists()",
            ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['P', 'tu', 'toi', 'phong', 'nhap'])",
            "P": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
            "tu": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 95" },
            "toi": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 95" },
            "phong": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
            "nhap": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
            "luc": { ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "xong": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "tiep": { ".write": "!data.exists()", ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
        "$khac": { ".validate": false }
      }
    },
    "sanh": {
      ".read": true,
      "$ma": {
        ".write": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!newData.exists() || (root.child('coba/' + $ma).exists() && !root.child('coba/' + $ma + '/batDau').exists()))",
        ".validate": "newData.hasChildren(['tao', 'ten', 'trong', 'thay'])",
        "tao": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "ten": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "trong": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2" },
        "luat": { ".validate": "newData.val() === 'tq'" },
        "gio": { ".validate": "newData.isString() && newData.val().matches(/^(n30|n60|v5|v10)$/)" },
        "thay": { ".validate": "newData.val() === now" },
        "$khac": { ".validate": false }
      }
    },
    "bida": {
      "$ma": {
        ".read": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!data.exists() || (!newData.exists() && (data.child('tao').val() < now - 86400000 || data.child('xong').val() < now - 300000)))",
        ".validate": "newData.hasChildren(['tao', 'chu', 'kieu', 'so', 'kho', 'pha', 'ghe']) && (data.exists() || newData.hasChild('ban'))",
        "tao": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "kieu": { ".validate": "newData.val() === 8 || newData.val() === 9 || newData.val() === 3 || newData.val() === 52" },
        "so": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4 && (newData.val() === 2 || newData.parent().child('kieu').val() === 9 || newData.parent().child('kieu').val() === 52 || (newData.val() === 4 && newData.parent().child('doi').val() === true))" },
        "doi": { ".validate": "newData.val() === true && newData.parent().child('so').val() === 4 && (newData.parent().child('kieu').val() === 8 || newData.parent().child('kieu').val() === 3)" },
        "la": { ".validate": "newData.parent().child('kieu').val() === 52 && (newData.val() === 3 || newData.val() === 5 || newData.val() === 7)" },
        "chu": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().child('so').val()" },
        "pha": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().child('so').val()" },
        "kho": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
        "ghe": {
          "$P": {
            ".validate": "$P.matches(/^[0-3]$/) && newData.hasChild('id')",
            "id": {
              ".write": "!data.exists() && !root.child('bida/' + $ma + '/batDau').exists() && root.child('bida/' + $ma + '/duyet/' + newData.val()).val() === true",
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,16}$/)"
            },
            "ten": { ".write": true, ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "thay": { ".write": true, ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "batDau": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "cu": {
          "$n": {
            ".write": "!data.exists() && root.child('bida/' + $ma + '/batDau').exists()",
            ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['P', 'd', 'kq'])",
            "P": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "d": { ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^[-0-9,]+$/)" },
            "kq": { ".validate": "newData.isString() && newData.val().length <= 400 && newData.val().matches(/^[-0-9.,:;]+$/)" },
            "$khac": { ".validate": false }
          }
        },
        "xong": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "tiep": { ".write": "!data.exists()", ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
        "luat": { ".validate": "newData.val() === 0 || newData.val() === 1 || newData.val() === 3" },
        "dich": { ".validate": "newData.val() === 5 || newData.val() === 10 || newData.val() === 15 || newData.val() === 25" },
        "ban": { ".validate": "newData.isString() && newData.val().matches(/^[LP][1-8]$/) && (newData.val().beginsWith('P') === (newData.parent().child('kieu').val() === 3))" },
        "xin": {
          "$id": {
            ".write": "!root.child('bida/' + $ma + '/batDau').exists()",
            ".validate": "$id.matches(/^[a-z0-9]{8,16}$/) && newData.hasChildren(['ten', 'thay'])",
            "ten": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "P": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "thay": { ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "duyet": {
          "$id": { ".write": "!root.child('bida/' + $ma + '/batDau').exists()", ".validate": "$id.matches(/^[a-z0-9]{8,16}$/) && newData.isBoolean()" }
        },
        "duoi": {
          "$P": {
            ".write": "!data.exists() && root.child('bida/' + $ma + '/batDau').exists()",
            ".validate": "$P.matches(/^[0-3]$/) && newData.hasChildren(['n', 'luc'])",
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999" },
            "luc": { ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "$khac": { ".validate": false }
      }
    },
    "quan": {
      ".read": true,
      "$ban": {
        ".write": "$ban.matches(/^[LP][1-8]$/) && (!data.exists() || data.child('thay').val() < now - 180000 || newData.child('ma').val() === data.child('ma').val() || !root.child('bida/' + data.child('ma').val()).exists() || root.child('bida/' + data.child('ma').val() + '/xong').exists())",
        ".validate": "newData.hasChildren(['ma', 'kieu', 'so', 'thay'])",
        "ma": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
        "kieu": { ".validate": "($ban.beginsWith('L') && (newData.val() === 8 || newData.val() === 9 || newData.val() === 52)) || ($ban.beginsWith('P') && newData.val() === 3)" },
        "so": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4" },
        "doi": { ".validate": "newData.isBoolean()" },
        "la": { ".validate": "$ban.beginsWith('L') && (newData.val() === 3 || newData.val() === 5 || newData.val() === 7)" },
        "thay": { ".validate": "newData.val() === now" },
        "choi": { ".validate": "newData.isBoolean()" },
        "luat": { ".validate": "$ban.beginsWith('P') && (newData.val() === 0 || newData.val() === 1 || newData.val() === 3)" },
        "dich": { ".validate": "$ban.beginsWith('P') && (newData.val() === 5 || newData.val() === 10 || newData.val() === 15 || newData.val() === 25)" },
        "ten": { "$P": { ".validate": "$P.matches(/^[0-3]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" } },
        "xem": {
          "$id": { ".write": true, ".validate": "$id.matches(/^[a-z0-9]{8,16}$/) && newData.val() === now" }
        },
        "$khac": { ".validate": false }
      }
    },
    "buonlau": {
      "$ma": {
        ".read": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!data.exists() || (!newData.exists() && (data.child('tao').val() < now - 86400000 || data.child('xong').val() < now - 300000)))",
        ".validate": "newData.hasChildren(['tao', 'chu', 'kieu', 'kho', 'truoc', 'ghe'])",
        "tao": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "kieu": { ".validate": "newData.val() === '1v1' || newData.val() === '2v2'" },
        "chu": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (newData.parent().child('kieu').val() === '2v2' ? 3 : 1)" },
        "kho": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
        "truoc": { ".validate": "newData.val() === 0 || newData.val() === 1" },
        "ghe": {
          "$P": {
            ".validate": "$P.matches(/^[0-3]$/) && (root.child('buonlau/' + $ma + '/kieu').val() === '2v2' || newData.parent().parent().child('kieu').val() === '2v2' || $P.matches(/^[01]$/)) && newData.hasChild('id')",
            "id": {
              ".write": "!data.exists() && !root.child('buonlau/' + $ma + '/batDau').exists()",
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,16}$/)"
            },
            "ten": { ".write": true, ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "thay": { ".write": true, ".validate": "newData.val() === now" },
            "$khac": { ".validate": false }
          }
        },
        "batDau": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "may": {
          "$P": { ".write": true, ".validate": "$P.matches(/^[0-3]$/) && newData.val() === true" }
        },
        "nuoc": {
          "$n": {
            ".write": "!data.exists() && root.child('buonlau/' + $ma + '/batDau').exists()",
            ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['P', 'h', 'l', 'k']) && (newData.child('l').val() === 'tb' ? !newData.hasChild('o') && !newData.hasChild('s') : newData.hasChildren(['o', 's']) && !newData.hasChild('c') && !newData.hasChild('t') && !newData.hasChild('v') && !newData.hasChild('b'))",
            "P": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "h": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "l": { ".validate": "newData.val() === 'tb' || newData.val() === 'hq'" },
            "k": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30" },
            "c": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{16}$/)" },
            "t": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
            "v": { ".validate": "newData.val() === 1" },
            "b": { ".validate": "newData.val() === 1" },
            "o": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}(,[0-9]{1,2}){2,3}$/)" },
            "s": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 60" },
            "$khac": { ".validate": false }
          }
        },
        "dap": {
          "$id": {
            ".write": "!data.exists() && root.child('buonlau/' + $ma + '/batDau').exists()",
            ".validate": "$id.matches(/^[01]-[0-9]{1,2}-[01]$/) && newData.hasChildren(['r', 'g'])",
            "r": { ".validate": "newData.val() === 'b' || newData.val() === 't' || newData.val() === 'x' || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 40)" },
            "g": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 60" },
            "$khac": { ".validate": false }
          }
        },
        "mo": {
          "$id": {
            ".write": "!data.exists() && root.child('buonlau/' + $ma + '/batDau').exists()",
            ".validate": "$id.matches(/^[01]-[01]$/) && newData.hasChildren(['m', 'd', 'f', 'g'])",
            "m": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,40}$/)" },
            "d": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[0-9,]*$/)" },
            "f": { ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[0-9:,]*$/)" },
            "g": { ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[0-9:,]*$/)" },
            "$khac": { ".validate": false }
          }
        },
        "xong": { ".write": "!data.exists()", ".validate": "newData.val() === now" },
        "tiep": { ".write": "!data.exists()", ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
        "$khac": { ".validate": false }
      }
    },
    "sanhbuonlau": {
      ".read": true,
      "$ma": {
        ".write": "$ma.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!newData.exists() || (root.child('buonlau/' + $ma).exists() && !root.child('buonlau/' + $ma + '/batDau').exists()))",
        ".validate": "newData.hasChildren(['tao', 'ten', 'trong', 'kieu', 'thay'])",
        "tao": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "ten": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "trong": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
        "kieu": { ".validate": "newData.val() === '1v1' || newData.val() === '2v2'" },
        "thay": { ".validate": "newData.val() === now" },
        "$khac": { ".validate": false }
      }
    }
  }
}
